# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
.coverage
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────
venv/
.venv/
env/

# ── WinDesktopMgr — personal data (never commit these) ────────────────────
# Cache files contain your personal system data
event_id_cache.json
bsod_code_cache.json
startup_item_cache.json
services_item_cache.json
process_cache.json
bios_cache.json
identify_cache.json

# Log files
*.log
*.log.*
windesktopmgr.log
Logs/

# Launcher bat (generated by setup-startup.ps1 — contains your local paths)
start-windesktopmgr.bat

# BIOS cache
bios_cache.json

# Home network & remediation runtime data
homenet_inventory.json
homenet_scan_history.json
remediation_history.json

# NAS SNMP config — holds the read-only community string; never commit.
# The committed template is nas_config.example.json.
nas_config.json

# Drive-health snooze store (runtime; per-machine)
disk_snoozes.json

# BIOS audit trail (generated by tray + scheduled task)
bios_audit_history.json

# Memory warning snooze store (runtime state)
memory_snoozes.json

# Alert rules user overrides (runtime state)
alert_rules.json

# Trend sampler history (runtime state, regenerates on each tray poll)
metrics_history.json

# Baseline / drift-detection (backlog #14 runtime state)
baseline_snapshot.json
baseline_history.json
baseline_accept_watermark.json

# Backup tab runtime state (backlog #47 — wbadmin/File-History scan cache + action audit)
backup_cache.json
backup_actions_history.json
fh_storage_cache.json

# CloudCopy / OneDrive→iCloud replicator rules (backlog #46 runtime state)
cloudcopy_rules.json
cloudcopy_history.json

# Codehealth scanner state (backlog #51 runtime state, regenerates on scan)
codehealth_state.json
codehealth_emitted.json

# ── Sensitive / personal ───────────────────────────────────────────────────
# Gmail credentials (encrypted, but best not committed)
gmail_credentials.json
gmail_token.json
*.token
# Email config (contains SMTP credentials)
diag_email_config.xml

# Any generated reports
System Health Reports/

# ── LinkedIn drafts ───────────────────────────────────────────────────────
linkedin_post*.md
linkedin_preview*.html

# ── Design mockups (scratch design concepts, not served by the app) ───────
mockups/

# ── OS files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor files ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
# .claude/ contains both local-only state (settings.json, launch.json,
# worktrees/) AND checked-in project automations (skills/, commands/).
# Ignore the contents by default but re-include the automation
# subtrees as tracked -- git can't re-include into a wholesale-ignored
# directory, so we ignore the contents (.claude/*) rather than the
# directory itself.
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/commands/
!.claude/commands/**
scripts/_probe_dumps/
backups/
